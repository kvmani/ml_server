APP_HOST=127.0.0.1
APP_PORT=5000
APP_DEBUG=false
APP_SECRET_KEY=__SET_SECRET_KEY__
APP_LOGGING__LOG_DIR=logs
APP_LOGGING__LOG_FILE=app.log
APP_LOGGING__FORMAT="%(asctime)s [%(levelname)s] %(message)s"
APP_CELERY__BROKER_URL=redis://redis:6379/0
APP_CELERY__RESULT_BACKEND=redis://redis:6379/0
APP_HYDRIDE_SEGMENTATION__ML_MODEL__URL=http://localhost:5004/infer
APP_HYDRIDE_SEGMENTATION__ML_MODEL__HEALTH_URL=http://localhost:5004
APP_HYDRIDE_SEGMENTATION__ML_MODEL__PORT=5004
APP_HYDRIDE_SEGMENTATION__ML_MODEL__TIMEOUT=30
APP_FEEDBACK__DATABASE_PATH=data/engagement.sqlite3
APP_ANALYTICS__ENABLED=true
# Optional internal SMTP relay. Feedback remains saved if delivery fails.
APP_EMAIL__ENABLED=false
APP_EMAIL__SMTP_HOST=
APP_EMAIL__SMTP_PORT=25
APP_EMAIL__USE_TLS=false
APP_EMAIL__USERNAME=
APP_EMAIL__PASSWORD=
APP_EMAIL__FROM_ADDRESS=noreply@intranet.local
APP_EMAIL__DEVELOPER_ADDRESS=kvmani@barc.gov.in
APP_DOWNLOAD__PROCESSED_DATA_PATH=tmp/processed_data.bin
APP_SECURITY__ADMIN_TOKEN=__SET_ADMIN_TOKEN__
APP_SECURITY__ALLOWED_ORIGINS="[http://localhost:5000]"
APP_SECURITY__CSRF_ENABLED=true
APP_SECURITY__SSL_ENABLED=false
ML_SERVER_CONFIG=config/config.intranet.json

# --- Admin dashboard ------------------------------------------------------
# The operations console password. Set exactly one of these, in the service
# environment (a systemd EnvironmentFile), never in git. Prefer the hash:
# generate it with `ml-server --hash-admin-password`.
ML_SERVER_ADMIN_PASSWORD_HASH=
# ML_SERVER_ADMIN_PASSWORD=
# How long usage analytics are retained before the dashboard's prune action
# discards them.
APP_ANALYTICS__RETENTION_MONTHS=24

# Number of reverse proxies in front of the portal. 0 (the office deployment,
# where gunicorn is reached directly) means X-Forwarded-For and
# X-Forwarded-Proto are not trusted, so a client cannot forge its own address
# past the admin login lockout.
APP_SECURITY__TRUSTED_PROXY_COUNT=0
# Where the portal keeps small files it owns, notably the generated session
# signing key when APP_SECRET_KEY / secret_key is unset. Defaults to the
# directory holding the config file, which on the server is shared/config/.
# ML_SERVER_STATE_DIR=
